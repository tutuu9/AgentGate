# AgentGate reads process environment variables, not .env files.
# Export only the settings you need in your shell. Examples below are placeholders.
# Keep the state home outside every target repository.
# AGENTGATE_HOME=/absolute/path/to/agentgate-state

# Optional native executables; leave unset to resolve them from PATH.
# AGENTGATE_CODEX_PATH=/absolute/path/to/codex
# AGENTGATE_GH_PATH=/absolute/path/to/gh

# Authenticate with the native tools. Never put tokens or API keys in this file.
# For native Codex login only, set CODEX_HOME to <AGENTGATE_HOME>/codex.
# The runtime sets its own Codex profile and does not fall back to API billing.
